	"people": [
		{
			"name": "棉棉",
			"head": "bow_sage",
			"body": "vest_sage",
			"personality": "温柔慢热",
			"lines": [
				"早呀……或者，该说下午好？\n能在这里碰见你，真好。",
				"我刚刚给小苗浇过水了。\n它没说谢谢，不过叶子精神了一点。",
				"如果今天有点累，就坐一会儿吧。\n我可以陪你听风，不用说话也没关系。",
				"海边的贝壳，我总会留一半在原地。\n也许下一只兔兔看见了，会很开心。",
				"我不太会挑礼物……\n但如果你喜欢，我可以送你一场日落。"
			]
		},
		{
			"name": "小葵",
			"head": "beret_honey",
			"body": "overalls_rose",
			"personality": "活泼好奇",
			"lines": [
				"你来得正好！我发现了一个秘密——\n沿着海边走一圈，居然会回到原地！",
				"今天想种哪一种菜呀？\n我想种南瓜！长大以后能不能当小椅子？",
				"快看我的新帽子！\n戴上以后，感觉连散步都有新路线了！",
				"你说，云会不会也有自己的背包？\n不然它们把雨藏在哪里呀？",
				"我决定了，今天要认识一位新朋友！\n咦，我们已经认识了？那就再认识一次！"
			]
		},
		{
			"name": "阿圆",
			"head": "beret_sage",
			"body": "vest_honey",
			"personality": "认真迷糊",
			"lines": [
				"我正在调查这条路为什么这么长。\n目前的结论是：我还没有走到头。",
				"按照计划，我应该向北走。\n等一下……哪边是我刚才说的北？",
				"石灰石和铜矿要用不同的工具。\n这个我记得很清楚。工具放哪了就……",
				"我给每一朵云都起了编号。\n可惜刚编到第三朵，它们就换了位置。",
				"今天的待办事项已经写好了。\n第一项：找到写着待办事项的那张纸。"
			]
		},
		{
			"name": "团子",
			"head": "bow_honey",
			"body": "overalls_honey",
			"personality": "悠闲吃货",
			"lines": [
				"唔……海风里有面包的味道。\n我本来想散步，现在想顺路吃一点。",
				"番茄、胡萝卜、生菜、南瓜……\n这不是种植计划，是我的晚餐计划。",
				"别着急，太阳还没下山呢。\n就算下山了，我们也可以慢慢吃。",
				"我刚才在长椅上认真想了一件事。\n午睡之前吃点心，还是醒来再吃？",
				"有人说，走路能让肚子饿得快一点。\n所以你看，我一直都很努力。"
			]
		}
	],
	"cat": {
		"name": "猫咪老师",
		"species": "cat_teacher",
		"lines": [
			"哼，吾辈只是在巡视小岛。\n才不是闻着点心的味道过来的。",
			"那边的阳光不错。\n等我睡醒，再告诉你散步的诀窍。",
			"种菜记得浇水。等收成好了……\n给吾辈留一份，也不是不可以。",
			"别被吾辈这副样子骗了。\n遇到麻烦就来找我，知道了吗？",
			"海风、长椅，还有慢吞吞的小兔子。\n嗯，这里倒是个适合久住的地方。"
		]
	},
	"youmu": {
		"name": "又木",
		"species": "panda",
		"personality": "温吞爱自然",
		"lines": [
			"刚才路过菜园，看见一片新叶子。\n它长得不着急，我也就慢慢走。",
			"你觉得这顶帽子像不像一片叶子？\n我试过戴真的叶子……海风把它借走了。",
			"想去海边坐一小会儿。\n如果捡到漂亮的贝壳，分你一颗。",
			"围巾暖暖的，路也还很长。\n今天换条没走过的小路吧。",
			"我叫又木。又见面的又，树木的木。\n下次见面，希望刚好有阳光。"
		]
	},
	"panda": {
		"name": "潘达",
		"lines": [
			"欢迎来到眠风山谷。\n桥那边的风，会带一点橘子的香气。",
			"桦树倒下来以后，还能陪我们很久。\n记得带铜斧，慢慢砍，不要着急。",
			"我最喜欢踩着石阶去散步。\n上坡的时候，云好像也近了一点。",
			"睡前听溪水流过，我就不数羊啦。\n数到第三块石头，眼睛就睁不开了。",
			"今天摘的橘子，有一颗特别甜。\n也许明天轮到你找到它。"
		]
	},
	"visitors": [
		[
			"嘘，你听。溪水在石头旁边拐了一个弯。\n我想在这里多听一小会儿。",
			"早上顺着石阶走，叶子上还有露水。\n你也想去高处看看吗？",
			"我给这片树林起了好多名字。\n可是每次风来，它们又有点不一样了。",
			"这顶帽子装不下整片森林。\n不过能装下一片小叶子。",
			"天黑以后，我就回去休息啦。\n明天太阳出来，再一起散步吧。"
		],
		[
			"桥那边的橘子好像更甜！\n也可能是我走过去的时候饿了。",
			"今天要走哪条小路？\n我抛了片叶子……它还没落下来。",
			"我发现了五根树枝。\n数完以后，忘了第一根在哪里。",
			"如果石阶变成饼干，\n上山这件事可能会慢一点。",
			"到晚上十点，我就要回去啦。\n溪水还在，我们明天再见。"
		]
	],
