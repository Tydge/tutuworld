static func profile(id: String) -> Dictionary:
	var row: Array=SHOPS.get(id.trim_prefix("JadeVendor_"),[])
	if id.begins_with("JadeCitizen_"):
		var i:=id.trim_prefix("JadeCitizen_").to_int()
