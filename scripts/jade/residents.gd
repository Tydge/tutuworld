	"furniture":["木樨","木作掌柜，温和讲究",["试着推这圈椅的背。顺着圈儿过去，手底下不该摸到一道棱。","木头也认脾气，急了它就裂。我这儿的货都慢慢阴干过。","刚掸过架上的灰，衣袖放心搁。","你挑中的大件我记账送进仓里，不用你顶着它摸黑回家。"]],
	"tools":["锻青","铁匠，话少耳背",["你说要斧？哦，要镐。等我把耳朵里这点锤声倒出来。","握这里。手离斧头近些，先试掂，不急着挥。","炉子刚红，头一锤听着最脆。","火收小了，工具照卖。别碰案上那块黑铁，它还烫。"]]}
# A neighbour mentions a finished errand once when next met in town.
const AFTER_WORK := {
	"JadeCitizen_0":["stitch","瞧！燕尾补上啦。我娘一看针脚就问是谁的手艺。反正她一眼认出不是我。"],
	"JadeCitizen_2":["weave","你织的回纹我看过啦。数到第六梭差点跟丢，算你赢一回！"],
	"JadeCitizen_21":["kiln","昨日那炉开出来，我把脸凑到碗边，釉里照出两只黑鼻头。还有一只是师父的。"],
	"JadeCitizen_23":["weir","听见没？田沟里响了。我家那头牛就爱喝头一拨水，拽都拽不住。"],
	"JadeCitizen_30":["ledger","你算盘收好后，我又心算了一遍。一个子儿都对得上。咳，我也没算慢多少。"],
	"JadeCitizen_35":["archive","漕图的旧签我用蓝线另捆了。你校过的那卷在右手边，来借图的人一伸爪就拿着。"],
	"JadeCitizen_38":["pipa","你弹到第三个音的时候，我在帘后跟着哼了一声。你……应该没听见吧？"],
	"JadeVendor_almond":["pastry","给你留的那块酥，记得垫张纸，别把袍子的前襟吃成花的。"]}
static func profile(id: String) -> Dictionary:
	var row: Array
	if id=="JadeEmperor":row=EMPEROR
	elif id.begins_with("JadeCitizen_"):
		var suffix:=id.trim_prefix("JadeCitizen_")
		if not suffix.is_valid_int():return {}
		var index:=suffix.to_int()
		if index<0 or index>=PEOPLE.size():return {}
		row=PEOPLE[index]
	elif id.begins_with("JadeVendor_"):
		row=SHOPS.get(id.trim_prefix("JadeVendor_"),[])
	if row.is_empty():return {}
	var voice: Array=row.back()
	return {"name":row[0],"personality":row[1],"lines":[{"text":voice[0]},{"text":voice[1]},{"text":voice[2],"start":6,"end":18},{"text":voice[3],"start":18,"end":6}]}
